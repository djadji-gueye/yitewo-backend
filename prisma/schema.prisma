model BusinessListing {
  id               String                 @id @default(uuid())
  slug             String?                @unique
  googlePlaceId    String?                @unique
  externalSourceId String?                @unique
  name             String
  category         String?
  city             String
  zone             String?
  address          String?
  phone            String?
  email            String?
  website          String?
  latitude         Float?
  longitude        Float?
  description      String?
  imageUrl         String?
  source           BusinessListingSource  @default(MANUAL)
  status           BusinessListingStatus  @default(PENDING)
  isClaimed        Boolean                @default(false)
  isVisible        Boolean                @default(false)
  claimRequestedAt DateTime?
  verifiedAt       DateTime?
  rejectedReason   String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
}

enum BusinessListingSource {
  GOOGLE
  MANUAL
  ADMIN
  IMPORT
  OPENSTREETMAP
}

enum BusinessListingStatus {
  DRAFT
  PENDING
  VISIBLE
  VERIFIED
  REJECTED
}
